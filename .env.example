# Copy to .env and fill in. .env is gitignored and never committed.
# A private key never leaves this file.
# This example carries names only, never values.

# Brickken Sandbox API key, issued by hand to the sandbox account email.
BRICKKEN_API_KEY=

# Sepolia (11155111) JSON-RPC endpoint. Any provider; testnet only.
SEPOLIA_RPC_URL=

# Principal and agent are different addresses, deliberately.
# Principal grants and revokes the mandate and holds the asset.
PRINCIPAL_PRIVATE_KEY=

# Agent is Keeper's signer, the msg.sender into AgentExecutor.execute.
AGENT_PRIVATE_KEY=

# Counterparty is the address the agent transfers to. It only ever receives.
COUNTERPARTY_PRIVATE_KEY=

# Probe is a second agent. It holds its own mandate, so tests never spend the first one.
PROBE_PRIVATE_KEY=

# Uncleared is a recipient that is deliberately never cleared to hold the token.
# It is never funded and it is never submitted anywhere. Do not change that.
UNCLEARED_PRIVATE_KEY=

# Google Gemini API key. Keeper's reasoning runs on it, and only outside the test suite.
GEMINI_API_KEY=

# Tokenizer email for token creation. Must match the account the API key belongs to.
TOKENIZER_EMAIL=

# Etherscan API key, free from etherscan.io. Publishes the contract source.
ETHERSCAN_API_KEY=
