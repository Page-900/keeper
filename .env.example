# Copy to .env and fill in. .env is gitignored and never committed.
# A private key never leaves this file.
# This example carries names only, never values.

# Brickken Sandbox API key, issued by hand to the sandbox account email.
BRICKKEN_API_KEY=

# Sepolia (11155111) JSON-RPC endpoint. Any provider; testnet only.
SEPOLIA_RPC_URL=

# Principal and agent are different addresses, deliberately.
# Principal grants and revokes the mandate and holds the asset.
PRINCIPAL_PRIVATE_KEY=

# Agent is Keeper's signer, the msg.sender into AgentExecutor.execute.
AGENT_PRIVATE_KEY=

# Tokenizer email for token creation. Must match the account the API key belongs to.
TOKENIZER_EMAIL=
