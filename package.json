{
  "name": "keeper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:contracts": "hardhat test solidity contracts/test/AgentExecutor.t.sol",
    "test:fork": "node --env-file-if-exists=.env node_modules/hardhat/dist/src/cli.js test solidity contracts/test/ForkRehearsal.t.sol",
    "scan": "aislop ci",
    "verify": "node scripts/verify.js",
    "wallets": "node scripts/wallets.js",
    "deploy:executor": "node scripts/deploy-executor.js",
    "register:action": "node scripts/register-action.js",
    "verify:source": "node scripts/verify-source.js",
    "read:registry": "node scripts/read-registry.js",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:contracts && npm run build && npm run scan"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "viem": "2.55.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nomicfoundation/hardhat-verify": "3.0.22",
    "@openzeppelin/contracts": "5.6.1",
    "@types/node": "26.2.0",
    "aislop": "0.14.1",
    "eslint": "10.8.1",
    "forge-std": "git+https://github.com/foundry-rs/forge-std.git#v1.9.7",
    "hardhat": "3.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
